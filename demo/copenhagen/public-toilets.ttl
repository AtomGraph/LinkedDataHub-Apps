@prefix dh:   <https://www.w3.org/ns/ldt/document-hierarchy#> .
@prefix ldh:  <https://w3id.org/atomgraph/linkeddatahub#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix spin: <http://spinrdf.org/spin#> .
@prefix ac:   <https://w3id.org/atomgraph/client#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Main container document
<> a dh:Container ;
    dct:title "Public toilets" ;
    rdf:_1 <#toilets-intro> ;
    rdf:_2 <#select-children> .

# Intro XHTML
<#toilets-intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <div class="ldh-section">
            <h2>Public conveniences</h2>
            <p>211 public toilets carrying their opening hours and whether they are step-free. Both are properties
               of the facility, so the map answers availability and not just location.</p>
        </div>
    </div>"""^^rdf:XMLLiteral .

# Object block
<#select-children> a ldh:Object ;
    rdf:value <#select-children-view> .

# View block with MapMode
<#select-children-view> a ldh:View ;
    dct:title "All public toilets" ;
    spin:query ldh:SelectChildren ;
    ac:mode ac:MapMode .
