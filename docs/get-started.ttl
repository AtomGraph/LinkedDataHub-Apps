@prefix ldh:    <https://w3id.org/atomgraph/linkeddatahub#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dh:     <https://www.w3.org/ns/ldt/document-hierarchy#> .
@prefix dct:    <http://purl.org/dc/terms/> .

<> a dh:Container ;
    dct:title "Get started" ;
    dct:description "Install LinkedDataHub, log in with a WebID, and request access to a dataspace" ;
    rdf:_1 <#content> ;
    rdf:_2 <#select-children> .

<#content> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
    <p class="lead">Install LinkedDataHub, log in with a WebID, and request access to a dataspace</p>
    <p>If you are wondering what LinkedDataHub is and what it can do, start with <a href="../about/">About LinkedDataHub</a>. The running example
        throughout the documentation is the <a href="https://github.com/AtomGraph/LinkedDataHub-Apps/tree/master/demo/northwind-traders" target="_blank">Northwind Traders demo app</a> — the iconic sample database as an RDF Knowledge Graph, running live at
        <a href="https://northwind-traders.demo.linkeddatahub.com/" target="_blank">northwind-traders.demo.linkeddatahub.com</a>.</p>
    <div>
        <h2 id="setup">Setup</h2>
        <p>Setup is only required if you plan to run your own instance of LinkedDataHub. It takes a few steps: create a configuration file and run a
            <code>make</code> command.</p>
        <p class="lead"><a href="setup/">Read setup instructions.</a></p>
        <p>If you want to use an existing instance of LinkedDataHub, proceed to the next step.</p>
    </div>
    <div>
        <h2 id="get-an-account">Get an account</h2>
        <p>With LinkedDataHub, you obtain a WebID and use its client certificate for authentication. You can obtain the WebID either by setting up your own instance or signing up on
            an existing instance. Alternatively, you can authenticate using your Google or ORCID login.</p>
        <p class="lead"><a href="get-an-account/">Read instructions on getting an account.</a></p>
    </div>
    <div>
        <h2 id="request-access">Request access</h2>
        <p>After you log in to (authenticate with) a LinkedDataHub instance, the next step is getting an authorization from its owners that allows you to view and possibly append or edit documents. That is done by issuing an access request.</p>
        <p class="lead"><a href="request-access/">Read instructions on requesting access.</a></p>
    </div>
    <div>
        <h2 id="where-to-next">Where to next</h2>
        <p>New to LinkedDataHub? The <a href="../tutorial/">tutorial</a> builds a complete application, from an empty dataspace to a published app.
            The <a href="../user-guide/">user guide</a> covers the everyday tasks in standalone recipes: <a href="../user-guide/create-data/">creating data</a>, <a href="../user-guide/import-data/">importing data</a>, <a href="../user-guide/edit-content/">editing content</a> in place, <a href="../user-guide/manage-dataspaces/">managing dataspaces</a>, <a href="../user-guide/manage-packages/">installing packages</a>, and <a href="../user-guide/version-history/">working with version history</a>. The <a href="../reference/">reference</a> describes every feature in full.</p>
        <p>Note that most management actions can also be performed using the <a href="../reference/command-line-interface/">CLI (Command Line Interface)</a>. Where applicable, the UI and CLI instructions are shown side by side.</p>
    </div>
</div>"""^^rdf:XMLLiteral .

<#select-children> a ldh:Object ;
    rdf:value ldh:ChildrenView .
